<?xml version="1.0"?>
<!DOCTYPE kinematic_chain [

<!ELEMENT kinematic_chain (tool_part, material_holder_part)>
<!ATTLIST kinematic_chain
	unit (mm|m|in) #REQUIRED
	name CDATA #IMPLIED
	machine CDATA #IMPLIED
	author CDATA #IMPLIED
	modified CDATA #IMPLIED
>
<!ELEMENT tool_part (segment+)>
<!ELEMENT material_holder_part (segment+)>
<!ELEMENT segment (initial_translation, initial_rotation, tool_holder?, box*)>
<!ATTLIST segment
	type CDATA #REQUIRED
	name CDATA #REQUIRED
	parameter_value_minimum CDATA #IMPLIED
	parameter_value_maximum CDATA #IMPLIED
>
<!ELEMENT tool_holder (section*)>
<!ATTLIST tool_holder
	length CDATA #IMPLIED
	radius CDATA #IMPLIED
	model CDATA #IMPLIED
>
<!ELEMENT section EMPTY>
<!ATTLIST section
	length CDATA #REQUIRED
	radius CDATA #REQUIRED
>
<!ELEMENT box EMPTY>
<!ATTLIST box
	x1 CDATA #REQUIRED
	x2 CDATA #REQUIRED
	y1 CDATA #REQUIRED
	y2 CDATA #REQUIRED
	z1 CDATA #REQUIRED
	z2 CDATA #REQUIRED
>
<!ELEMENT initial_translation EMPTY>
<!ATTLIST initial_translation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
>
<!ELEMENT initial_rotation EMPTY>
<!ATTLIST initial_rotation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
	alpha CDATA #REQUIRED
>
]>
<kinematic_chain unit="m" name="Mazak VTC-800/30SR, B swivel head, C rotary table on the fixed table" machine="Mazak VTC-800/30SR" author="Claude, from public catalogue data; the offsets are estimates" modified="2026-09-23">
<tool_part>
<segment type="PRISMATIC_LINK" name="X" parameter_value_minimum="-1.5" parameter_value_maximum="1.5" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Y" parameter_value_minimum="-0.4" parameter_value_maximum="0.4" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="-1" y="0" z="0" alpha="90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Z" parameter_value_minimum="-0.36" parameter_value_maximum="0.36" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="-1" z="0" alpha="90"/>
</segment>
<segment type="REVOLUTE_LINK" name="B" parameter_value_minimum="-110" parameter_value_maximum="110" >
<initial_translation x="0" y="0" z="0.4"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
</segment>
<segment type="TOOL" name="Tool holder" >
<initial_translation x="0.352" y="0" z="0"/>
<initial_rotation x="0.57735026919" y="-0.57735026919" z="-0.57735026919" alpha="120"/>
<box x1="-0.12" x2="0.12" y1="-0.12" y2="0.12" z1="0.08" z2="0.5"  />
<tool_holder model="BT40 ER32">
<section length="0.065" radius="0.0445"/>
<section length="0.025" radius="0.027"/>
<section length="0.035" radius="0.025"/>
</tool_holder>
</segment>
</tool_part>
<material_holder_part>
<segment type="REVOLUTE_LINK" name="C" parameter_value_minimum="-360" parameter_value_maximum="360" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="0"/>
</segment>
<segment type="MATERIAL_HOLDER" name="Material holder" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="0" z="1" alpha="0"/>
<box x1="-0.25" x2="0.25" y1="-0.25" y2="0.25" z1="-0.12" z2="-0.02"  />
</segment>
</material_holder_part>
</kinematic_chain>

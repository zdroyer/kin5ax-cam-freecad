<?xml version="1.0"?>
<!DOCTYPE kinematic_chain [

<!ELEMENT kinematic_chain (tool_part, material_holder_part)>
<!ATTLIST kinematic_chain
	unit (mm|m|in) #REQUIRED
	name CDATA #IMPLIED
>
<!ELEMENT tool_part (segment+)>
<!ELEMENT material_holder_part (segment+)>
<!ELEMENT segment (initial_translation, initial_rotation, tool_holder?, box*)>
<!ATTLIST segment
	type CDATA #REQUIRED
	name CDATA #REQUIRED
	parameter_value_minimum CDATA #IMPLIED
	parameter_value_maximum CDATA #IMPLIED
>
<!ELEMENT tool_holder (section*)>
<!ATTLIST tool_holder
	length CDATA #IMPLIED
	radius CDATA #IMPLIED
	model CDATA #IMPLIED
>
<!ELEMENT section EMPTY>
<!ATTLIST section
	length CDATA #REQUIRED
	radius CDATA #REQUIRED
>
<!ELEMENT box EMPTY>
<!ATTLIST box
	x1 CDATA #REQUIRED
	x2 CDATA #REQUIRED
	y1 CDATA #REQUIRED
	y2 CDATA #REQUIRED
	z1 CDATA #REQUIRED
	z2 CDATA #REQUIRED
>
<!ELEMENT initial_translation EMPTY>
<!ATTLIST initial_translation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
>
<!ELEMENT initial_rotation EMPTY>
<!ATTLIST initial_rotation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
	alpha CDATA #REQUIRED
>
]>
<kinematic_chain unit="m" >
<tool_part>
<segment type="PRISMATIC_LINK" name="Z" >
<initial_translation x="1" y="0" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="0"/>
</segment>
<segment type="PRISMATIC_LINK" name="X" >
<initial_translation x="0" y="0" z="1"/>
<initial_rotation x="0" y="1" z="0" alpha="-90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Y" >
<initial_translation x="0" y="0" z="1"/>
<initial_rotation x="1" y="0" z="0" alpha="90"/>
</segment>
<segment type="REVOLUTE_LINK" name="C" >
<initial_translation x="-0.2" y="0" z="0"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
<box x1="-0.15" x2="0.15" y1="-0.15" y2="0.15" z1="-0.1" z2="-0.06"  />
</segment>
<segment type="REVOLUTE_LINK" name="D" >
<initial_translation x="0" y="0" z="-0.1"/>
<initial_rotation x="1" y="0" z="0" alpha="90"/>
</segment>
<segment type="TOOL" name="Tool holder" >
<initial_translation x="0" y="-0.252" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="-90"/>
<box x1="-0.03" x2="0.03" y1="-0.03" y2="0.03" z1="0.05" z2="0.23"  />
<tool_holder length="0.05" radius="0.03"/>
</segment>
</tool_part>
<material_holder_part>
<segment type="MATERIAL_HOLDER" name="Material holder" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="0"/>
<box x1="0.4" x2="0.7" y1="-0.2" y2="0.3" z1="0" z2="0.1"  />
</segment>
</material_holder_part>
</kinematic_chain>

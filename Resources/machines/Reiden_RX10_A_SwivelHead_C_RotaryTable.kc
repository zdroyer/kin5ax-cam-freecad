<?xml version="1.0"?>
<!DOCTYPE kinematic_chain [

<!ELEMENT kinematic_chain (tool_part, material_holder_part)>
<!ATTLIST kinematic_chain
	unit (mm|m|in) #REQUIRED
	name CDATA #IMPLIED
	machine CDATA #IMPLIED
	author CDATA #IMPLIED
	modified CDATA #IMPLIED
>
<!ELEMENT tool_part (segment+)>
<!ELEMENT material_holder_part (segment+)>
<!ELEMENT segment (initial_translation, initial_rotation, tool_holder?, box*)>
<!ATTLIST segment
	type CDATA #REQUIRED
	name CDATA #REQUIRED
	parameter_value_minimum CDATA #IMPLIED
	parameter_value_maximum CDATA #IMPLIED
>
<!ELEMENT tool_holder EMPTY>
<!ATTLIST tool_holder
	length CDATA #REQUIRED
	radius CDATA #REQUIRED
>
<!ELEMENT box EMPTY>
<!ATTLIST box
	x1 CDATA #REQUIRED
	x2 CDATA #REQUIRED
	y1 CDATA #REQUIRED
	y2 CDATA #REQUIRED
	z1 CDATA #REQUIRED
	z2 CDATA #REQUIRED
>
<!ELEMENT initial_translation EMPTY>
<!ATTLIST initial_translation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
>
<!ELEMENT initial_rotation EMPTY>
<!ATTLIST initial_rotation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
	alpha CDATA #REQUIRED
>
]>
<kinematic_chain unit="m" name="Reiden RX10, A swivel head, XY cross table with C rotary table" machine="Reiden RX10" author="Claude, from public catalogue data; the offsets are estimates" modified="2026-09-23">
<tool_part>
<segment type="PRISMATIC_LINK" name="Z" parameter_value_minimum="-0.4" parameter_value_maximum="0.41" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="0"/>
</segment>
<segment type="REVOLUTE_LINK" name="A" parameter_value_minimum="-1" parameter_value_maximum="90" >
<initial_translation x="0" y="0" z="0.35"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
</segment>
<segment type="TOOL" name="Tool holder" >
<initial_translation x="0.302" y="0" z="0"/>
<initial_rotation x="0" y="-1" z="0" alpha="90"/>
<box x1="-0.02" x2="0.02" y1="-0.02" y2="0.02" z1="0.18" z2="0.35"  />
<tool_holder length="0.05" radius="0.03"/>
</segment>
</tool_part>
<material_holder_part>
<segment type="PRISMATIC_LINK" name="X" parameter_value_minimum="-0.5" parameter_value_maximum="0.5" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Y" parameter_value_minimum="-0.55" parameter_value_maximum="0.55" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="-1" y="0" z="0" alpha="90"/>
</segment>
<segment type="REVOLUTE_LINK" name="C" parameter_value_minimum="-360" parameter_value_maximum="360" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="-1" z="0" alpha="90"/>
</segment>
<segment type="MATERIAL_HOLDER" name="Material holder" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="0" z="-1" alpha="90"/>
<box x1="-0.5" x2="0.5" y1="-0.5" y2="0.5" z1="-0.12" z2="-0.02"  />
</segment>
</material_holder_part>
</kinematic_chain>

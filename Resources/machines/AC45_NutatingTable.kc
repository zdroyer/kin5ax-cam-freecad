<?xml version="1.0"?>
<!DOCTYPE kinematic_chain [

<!ELEMENT kinematic_chain (tool_part, material_holder_part)>
<!ATTLIST kinematic_chain
	unit (mm|m|in) #REQUIRED
	name CDATA #IMPLIED
>
<!ELEMENT tool_part (segment+)>
<!ELEMENT material_holder_part (segment+)>
<!ELEMENT segment (initial_translation, initial_rotation, tool_holder?, box*)>
<!ATTLIST segment
	type CDATA #REQUIRED
	name CDATA #REQUIRED
	parameter_value_minimum CDATA #IMPLIED
	parameter_value_maximum CDATA #IMPLIED
>
<!ELEMENT tool_holder (section*)>
<!ATTLIST tool_holder
	length CDATA #IMPLIED
	radius CDATA #IMPLIED
	model CDATA #IMPLIED
>
<!ELEMENT section EMPTY>
<!ATTLIST section
	length CDATA #REQUIRED
	radius CDATA #REQUIRED
>
<!ELEMENT box EMPTY>
<!ATTLIST box
	x1 CDATA #REQUIRED
	x2 CDATA #REQUIRED
	y1 CDATA #REQUIRED
	y2 CDATA #REQUIRED
	z1 CDATA #REQUIRED
	z2 CDATA #REQUIRED
>
<!ELEMENT initial_translation EMPTY>
<!ATTLIST initial_translation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
>
<!ELEMENT initial_rotation EMPTY>
<!ATTLIST initial_rotation
	x CDATA #REQUIRED
	y CDATA #REQUIRED
	z CDATA #REQUIRED
	alpha CDATA #REQUIRED
>
]>
<!--
  AC table with a 45 deg inclined (nutating) A axis, simplified. Units: metres. World: Z up.
  Tool side:  X, Y, Z, tool vertical, home tool point at (0,0,0.35).
  Table side: A about (1,0,1)/sqrt2 (in the XZ plane, 45 deg between +X and +Z), carrying C about
              the table normal. A and C intersect 0.10 above the table top.
              A = 0: table horizontal;  A = 180: table vertical, facing +X.
  A is limited to 0..180 deg, C is endless. Tool vectors with K < 0 are unreachable by design.
  Linear travels from home: X -0.35..+0.35, Y -0.25..+0.25, Z -0.45..+0.20.
  Solids: inclined bearing housing (fixed), cradle (swings with A), platter (turns with C), spindle head.
-->
<kinematic_chain unit="m" name="AC 45deg nutating table" >
<tool_part>
<segment type="PRISMATIC_LINK" name="X" parameter_value_minimum="-0.35" parameter_value_maximum="0.35" >
<initial_translation x="0" y="0.5" z="0.9"/>
<initial_rotation x="0" y="1" z="0" alpha="90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Y" parameter_value_minimum="-0.25" parameter_value_maximum="0.25" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="1" y="0" z="0" alpha="-90"/>
</segment>
<segment type="PRISMATIC_LINK" name="Z" parameter_value_minimum="-0.45" parameter_value_maximum="0.2" >
<initial_translation x="0" y="0" z="-0.5"/>
<initial_rotation x="0" y="1" z="0" alpha="-90"/>
</segment>
<segment type="TOOL" name="Tool holder" >
<initial_translation x="0" y="0" z="-0.502"/>
<initial_rotation x="0" y="0" z="1" alpha="-90"/>
<box x1="-0.07" x2="0.07" y1="-0.07" y2="0.07" z1="0.05" z2="0.45"  />
<tool_holder length="0.05" radius="0.03"/>
</segment>
</tool_part>
<material_holder_part>
<segment type="REVOLUTE_LINK" name="A" parameter_value_minimum="0" parameter_value_maximum="180" >
<initial_translation x="0" y="0" z="0.1"/>
<initial_rotation x="0" y="1" z="0" alpha="45"/>
<box x1="-0.12" x2="0.12" y1="-0.12" y2="0.12" z1="0.3" z2="0.5"  />
</segment>
<segment type="REVOLUTE_LINK" name="C" >
<initial_translation x="0" y="0" z="0"/>
<initial_rotation x="0" y="1" z="0" alpha="-45"/>
<box x1="-0.22" x2="0.22" y1="-0.22" y2="0.22" z1="-0.22" z2="-0.16"  />
</segment>
<segment type="MATERIAL_HOLDER" name="Material holder" >
<initial_translation x="0" y="0" z="-0.1"/>
<initial_rotation x="1" y="0" z="0" alpha="0"/>
<box x1="-0.16" x2="0.16" y1="-0.16" y2="0.16" z1="-0.05" z2="-0.02"  />
</segment>
</material_holder_part>
</kinematic_chain>
